# Supabase — client-safe keys only. Never commit the service-role key.
# Live project: org RigReceipts, project kfyzglmphwohbhigvdyy (ca-central-1).
# The publishable key (sb_publishable_...) is safe for client bundles.
EXPO_PUBLIC_SUPABASE_URL=https://kfyzglmphwohbhigvdyy.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_BGl53113tsDTG8BDUObMUQ_rZ-gxgdH

# Sentry — publishable client DSN (org rigreceipts, project rigreceipts-app).
# Safe to expose in the client bundle; leave empty to disable reporting in dev.
EXPO_PUBLIC_SENTRY_DSN=https://38f8e662f24f22d54640ff2155d83cb9@o4511757316915200.ingest.us.sentry.io/4511757327990784

# PostHog — product analytics. The Project API Key (phc_...) is a client-side
# key, safe to ship in the app bundle. Leave empty to disable analytics (the
# facade falls back to a dev logger). Set HOST to https://eu.i.posthog.com for
# an EU project; US cloud is the default.
EXPO_PUBLIC_POSTHOG_KEY=phc_tD7hzBPySxnqhDXSu3jFukZWB9SsJR5Z2BxpNkfejWvY
EXPO_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# RevenueCat — public SDK keys (client-safe). Set the platform keys for
# production (appl_... for iOS, goog_... for Android). The shared key below is a
# Test Store key (test_...): platform-agnostic, it drives RevenueCat's simulated
# purchase modal so the paywall works without App Store / Play Store setup.
# Platform keys win when set; with none set the app falls back to the local
# sandbox adapter. Requires a native (prebuild) build to run — not Expo Go.
EXPO_PUBLIC_REVENUECAT_KEY=test_TwdbBbcTyXrebTnNPGgRtbiBWRv
# EXPO_PUBLIC_REVENUECAT_IOS_KEY=appl_xxxxxxxxxxxxxxxxxxxxxxxxxx
# EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=goog_xxxxxxxxxxxxxxxxxxxxxxxxxx
